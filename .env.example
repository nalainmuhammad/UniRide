# ==============================================================================
# UniRide (CTMS v2.0) - Unified Environment Configuration Template
# Copy this file to `.env` for local development or set in your cloud provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Deployment Mode
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, 'development' for local coding
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Django 5 Backend Core Settings
# ------------------------------------------------------------------------------
# In production, generate a secure 50+ character random key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-in-production-random-50-character-key
ALLOWED_HOSTS=localhost,127.0.0.1,uniride.railway.app,uniride.onrender.com

# CORS Allowed Origins (Comma-separated URLs of your frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://uniride.vercel.app

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Supabase / Neon / Railway / Local Docker)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For Local Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniride_db

# Example for Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Example for Neon.tech:
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct component overrides (if not using DATABASE_URL):
DB_NAME=uniride_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False

# ------------------------------------------------------------------------------
# 4. Redis (For Django Channels ASGI WebSockets, Pub/Sub & Caching)
# ------------------------------------------------------------------------------
# Local Docker Redis:
REDIS_URL=redis://localhost:6379/0

# Example for Upstash Serverless Redis:
# REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# Example for Railway/Render Redis:
# REDIS_URL=redis://default:[PASSWORD]@redis.railway.internal:6379

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Security Tokens
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
# For RS256, paths to RSA keypairs (optional, defaults to HS256 with SECRET_KEY if unset)
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 6. C# .NET 10 DSA Microservice Connection
# ------------------------------------------------------------------------------
# URL where Django reaches the C# algorithmic service
# Local: http://localhost:5050
# Railway internal: http://dsa-service.railway.internal:5050
# Render internal: http://dsa-service:5050
DSA_SERVICE_URL=http://localhost:5050
DSA_INTERNAL_API_KEY=uniride-dsa-internal-secret-token-2026

# Mutual TLS (mTLS) - Set to True in production for zero-trust private networking
ENABLE_MTLS=False
MTLS_CLIENT_CERT_PATH=/certs/client.crt
MTLS_CLIENT_KEY_PATH=/certs/client.key
MTLS_CA_CERT_PATH=/certs/ca.crt

# ------------------------------------------------------------------------------
# 7. Frontend (Next.js 15 App Router) Public Variables
# ------------------------------------------------------------------------------
# Base API URL consumed by client browsers
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Real-time WebSocket Gateway URL consumed by Leaflet map & commuter clients
NEXT_PUBLIC_WS_TELEMETRY_URL=ws://localhost:8000/ws/telemetry/

# Production equivalents:
# NEXT_PUBLIC_API_BASE_URL=https://api.uniride.railway.app/api/v1
# NEXT_PUBLIC_WS_TELEMETRY_URL=wss://api.uniride.railway.app/ws/telemetry/

# OpenStreetMap / Mapbox Tile Access Token (Optional: default uses free OpenStreetMap tiles)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.optional_free_tier_token_here
